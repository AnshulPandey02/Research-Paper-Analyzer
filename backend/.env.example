# ==========================================
# Backend configuration  (copy to backend/.env and fill in)
# Never commit the real .env and never put keys in the frontend.
# ==========================================

# ---- AI bias analysis ----
# Primary provider: "gemini" or "openrouter"
AI_PROVIDER=gemini

# Gemini API key - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model tried first.
GEMINI_MODEL=gemini-3.8-flash

# Models tried next (in order) when the primary is overloaded (503/504),
# rate limited (429), unavailable for your key (404) or slow.
# If your primary model is often overloaded, put a "flash-lite" model first.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Timing (seconds). Defaults are fine for most setups.
# GEMINI_TIMEOUT_SECONDS=35     # hard limit for one model call
# GEMINI_HEDGE_SECONDS=12       # start the next model if no answer after this long
# GEMINI_BUDGET_SECONDS=100     # total time allowed for the bias analysis

# OpenRouter (optional second provider) - https://openrouter.ai/keys
# Leave the placeholder to keep it switched off.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Enable/disable bias analysis feature
BIAS_ANALYSIS_ENABLED=true

# ---- Plagiarism / similarity search ----
# CrossRef, arXiv, OpenAlex and Semantic Scholar need no key.
# Total time (seconds) allowed for all literature searches of one paper.
# PLAGIARISM_SEARCH_BUDGET_SECONDS=40

# Optional: a real contact email gives better rate limits on CrossRef/OpenAlex.
# CONTACT_EMAIL=

# Optional keys that raise rate limits.
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_API_KEY=

# Ask Gemini to suggest related papers when the databases return fewer than 5.
# These suggestions are labelled as unverified in the report.
GEMINI_PAPER_SEARCH=true

# IEEE Xplore API (optional) - https://developer.ieee.org/
IEEE_API_KEY=

# ---- Server ----
# MAX_UPLOAD_MB=25
# Comma-separated list of allowed browser origins, or * for any.
# CORS_ORIGINS=*

# Backend API URL used by the React app.
#
# Local development (recommended for demos):
VITE_API_BASE=http://127.0.0.1:8000
#
# Leave VITE_API_BASE unset to use the Vite dev proxy (same origin, /analyze
# and /health are forwarded to http://localhost:8000).
#
# Production: your deployed backend, e.g.
# VITE_API_BASE=https://paper-bias-detection.onrender.com
#
# Never put API keys in this file: everything prefixed with VITE_ is bundled
# into the public JavaScript. Keys belong in backend/.env only.
